# Production Environment Configuration for S3 Upload Pipeline

# Application Settings
NODE_ENV=production
PORT=3001
WORKER_PORT=3002

# Database Configuration
DATABASE_URL=postgresql://username:password@db-host:5432/s3_pipeline_prod
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT=30000

# Redis Configuration (for BullMQ)
REDIS_URL=redis://redis-host:6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_MAX_RETRIES=3

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY=3600

# File Upload Limits
MAX_FILE_SIZE=1073741824
MAX_IMAGE_SIZE=104857600
ALLOWED_FILE_TYPES=text/plain,application/json,application/pdf,image/jpeg,image/png,image/webp,application/zip
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Security Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRY=24h
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# LLM Integration
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=3

# Image Processing Configuration
IMAGE_PROCESSING_ENABLED=true
OCR_ENABLED=true
OCR_LANGUAGES=eng,spa,fra
IMAGE_VARIANT_SIZES=thumbnail:150x150,web:800x600,large:1920x1080
IMAGE_QUALITY=85
IMAGE_FORMAT=webp

# Queue Configuration
QUEUE_CONCURRENCY_VALIDATION=10
QUEUE_CONCURRENCY_PARSING=5
QUEUE_CONCURRENCY_IMAGE=3
QUEUE_CONCURRENCY_LLM=2
QUEUE_CONCURRENCY_CLEANUP=3
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Security Scanning
VIRUS_SCANNING_ENABLED=true
PII_DETECTION_ENABLED=true
MALWARE_SCANNING_ENABLED=true

# Performance Settings
WORKER_MEMORY_LIMIT=2048
PROCESSING_TIMEOUT=300000
CLEANUP_INTERVAL=3600000
TEMP_FILE_RETENTION=86400000

# External Services
NOTIFICATION_SERVICE_URL=https://notifications.yourcompany.com
ANALYTICS_SERVICE_URL=https://analytics.yourcompany.com
MONITORING_SERVICE_URL=https://monitoring.yourcompany.com

# Feature Flags
ENABLE_BATCH_PROCESSING=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ADVANCED_OCR=true
ENABLE_VISUAL_ELEMENT_DETECTION=true
ENABLE_CODE_EXTRACTION=true
ENABLE_SENSITIVE_DATA_DETECTION=true