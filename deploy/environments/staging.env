# Staging Environment Configuration for S3 Upload Pipeline

# Application Settings
NODE_ENV=staging
PORT=3001
WORKER_PORT=3002

# Database Configuration
DATABASE_URL=postgresql://username:password@staging-db-host:5432/s3_pipeline_staging
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Redis Configuration (for BullMQ)
REDIS_URL=redis://staging-redis-host:6379
REDIS_PASSWORD=staging-redis-password
REDIS_DB=1
REDIS_MAX_RETRIES=3

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=staging-access-key-id
AWS_SECRET_ACCESS_KEY=staging-secret-access-key
S3_BUCKET_NAME=staging-s3-bucket-name
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY=3600

# File Upload Limits (More permissive for testing)
MAX_FILE_SIZE=2147483648
MAX_IMAGE_SIZE=209715200
ALLOWED_FILE_TYPES=text/plain,application/json,application/pdf,image/jpeg,image/png,image/webp,application/zip,text/csv,application/xml
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff

# Security Configuration
JWT_SECRET=staging-jwt-secret-key-not-for-production
JWT_EXPIRY=24h
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=300000
RATE_LIMIT_MAX=200

# LLM Integration
LLM_PROVIDER=openai
OPENAI_API_KEY=staging-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
LLM_TIMEOUT=45000
LLM_MAX_RETRIES=5

# Image Processing Configuration
IMAGE_PROCESSING_ENABLED=true
OCR_ENABLED=true
OCR_LANGUAGES=eng,spa,fra,deu
IMAGE_VARIANT_SIZES=thumbnail:150x150,web:800x600,large:1920x1080,xlarge:3840x2160
IMAGE_QUALITY=90
IMAGE_FORMAT=webp

# Queue Configuration (Higher concurrency for testing)
QUEUE_CONCURRENCY_VALIDATION=15
QUEUE_CONCURRENCY_PARSING=8
QUEUE_CONCURRENCY_IMAGE=5
QUEUE_CONCURRENCY_LLM=3
QUEUE_CONCURRENCY_CLEANUP=5
QUEUE_RETRY_ATTEMPTS=5
QUEUE_RETRY_DELAY=3000

# Monitoring and Logging
LOG_LEVEL=debug
ENABLE_AUDIT_LOGGING=true
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=15000

# Security Scanning (Relaxed for testing)
VIRUS_SCANNING_ENABLED=false
PII_DETECTION_ENABLED=true
MALWARE_SCANNING_ENABLED=false

# Performance Settings
WORKER_MEMORY_LIMIT=4096
PROCESSING_TIMEOUT=600000
CLEANUP_INTERVAL=1800000
TEMP_FILE_RETENTION=43200000

# External Services (Staging endpoints)
NOTIFICATION_SERVICE_URL=https://staging-notifications.yourcompany.com
ANALYTICS_SERVICE_URL=https://staging-analytics.yourcompany.com
MONITORING_SERVICE_URL=https://staging-monitoring.yourcompany.com

# Feature Flags (All enabled for testing)
ENABLE_BATCH_PROCESSING=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ADVANCED_OCR=true
ENABLE_VISUAL_ELEMENT_DETECTION=true
ENABLE_CODE_EXTRACTION=true
ENABLE_SENSITIVE_DATA_DETECTION=true
ENABLE_EXPERIMENTAL_FEATURES=true

# Testing Configuration
ENABLE_TEST_ENDPOINTS=true
MOCK_EXTERNAL_SERVICES=false
PERFORMANCE_MONITORING=true