{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm i && pnpm run migrate:rollback && pnpm run migrate && pnpm run seed",
    "start": "node ./index.js",
    "dev": "nodemon ./index.js",
    "worker": "node ./worker.js",
    "worker:dev": "nodemon ./worker.js",
    "connect": "psql -U postgres -d react_auth_example",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "seed:make": "knex seed:make",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^5.56.9",
    "connect-session-knex": "^3.0.1",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.0.0",
    "dotenv": "^16.0.3",
    "exif-reader": "^2.0.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.17.3",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.4.2",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.10.0",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "^8.39.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "services/**/*.js",
      "!services/**/node_modules/**",
      "!services/**/tests/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
